# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

# TODO: Update with the MLflow experiment you want to log traces and models to
MLFLOW_EXPERIMENT_ID=

# Remote Microsoft Foundry A2A endpoint for the hosted agent you want to forward to
FOUNDRY_A2A_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<project-id>/agents/<agent-id>/endpoint/protocols/a2a
# Friendly name or id for the target Foundry agent (used for tracing/logging)
FOUNDRY_AGENT_NAME=<your-foundry-agent-name>
# TODO: Fill in the Entra resource scope accepted by the remote A2A endpoint
FOUNDRY_A2A_SCOPE=api://<remote-foundry-agent-app-id>/.default

# TODO: Fill in the Entra Agent ID values created by `uv run create-agent-identity`
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_AGENT_CLIENT_ID=<your-agent-identity-client-id>

# Choose exactly one credential mechanism below for autonomous agent auth:
# 1) Client secret fallback
# TODO: Store this in a Databricks secret for deploys instead of committing it locally
ENTRA_AGENT_CLIENT_SECRET=
# 2) Certificate auth (preferred): PEM bundle path + thumbprint for the agent identity cert
ENTRA_AGENT_CLIENT_CERTIFICATE_PATH=
ENTRA_AGENT_CLIENT_CERTIFICATE_THUMBPRINT=
ENTRA_AGENT_CLIENT_CERTIFICATE_PASSWORD=
# 3) Federated credential token file path
ENTRA_AGENT_FEDERATED_TOKEN_FILE=

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"
